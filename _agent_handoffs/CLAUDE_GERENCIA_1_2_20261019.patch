+  }
+  porNome.set(n.projectId,nomes);porCanonica.set(n.projectId,canonicas);
+ }
+ return {...base,porNome,porCanonica,rotulos,normas:[...normas],normalizador:consolidado(base)&&normalizador?.ativo?normalizador:null};
