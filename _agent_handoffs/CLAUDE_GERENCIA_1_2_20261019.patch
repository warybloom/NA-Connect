diff --git a/Tests/NA_Connect.DisciplineAlias.Tests/Apoio.cs b/Tests/NA_Connect.DisciplineAlias.Tests/Apoio.cs
new file mode 100644
index 0000000..453e2cb
--- /dev/null
+++ b/Tests/NA_Connect.DisciplineAlias.Tests/Apoio.cs
@@ -0,0 +1,122 @@
+using APS.WebApp.Services.DisciplineAlias;
+using OfficeOpenXml;
+
+namespace NA_Connect.DisciplineAlias.Tests;
+
+/// <summary>Planilhas de teste geradas em memória (fixtures EXCLUSIVAS: siglas sintéticas, nunca o Excel oficial).</summary>
+internal static class Planilha
+{
+    // Mesma configuração global do Program.cs; vale para o leitor também (teste que não cria planilha antes).
+    [System.Runtime.CompilerServices.ModuleInitializer]
+    internal static void Licenca() => ExcelPackage.LicenseContext = LicenseContext.NonCommercial;
+
+    public static byte[] Criar(params string?[][] linhas) => CriarNaAba("Mapeamento", 1, linhas);
+
+    public static byte[] CriarNaAba(string aba, int primeiraLinha, params string?[][] linhas)
+    {
+        using var p = new ExcelPackage();
+        var ws = p.Workbook.Worksheets.Add(aba);
+        for (var r = 0; r < linhas.Length; r++)
+            for (var c = 0; c < linhas[r].Length; c++)
+                if (linhas[r][c] is { } v) ws.Cells[primeiraLinha + r, c + 1].Value = v;
+        return p.GetAsByteArray();
+    }
+}
+
+/// <summary>Store em memória com a mesma semântica do SQL (chave única, versão, auditoria, importação transacional).</summary>
+internal sealed class MemoriaStore : ISiglaDisciplinaStore
+{
+    private readonly object _lock = new();
+    private long _id, _imp;
+    public bool Instalado { get; set; } = true;
+    public List<RegraSigla> Regras { get; } = [];
+    public List<(long RegraId, string Acao, RegraSigla? Antes, RegraSigla? Depois, long? ImportacaoId, string Usuario)> Auditoria { get; } = [];
+    public List<ImportacaoRegistrada> Importacoes { get; } = [];
+
+    private void Garantir() { if (!Instalado) throw new NormalizadorNaoInstaladoException(); }
+
+    public Task<bool> InstaladoAsync(CancellationToken ct) => Task.FromResult(Instalado);
+    public Task<IReadOnlyList<RegraSigla>> ListarAsync(CancellationToken ct)
+    {
+        Garantir();
+        lock (_lock) return Task.FromResult<IReadOnlyList<RegraSigla>>(Regras.ToList());
+    }
+
+    private RegraSigla Inserir(DadosRegra d, string origem, long? imp, string usuario)
+    {
+        if (Regras.Any(r => r.SiglaChave == SiglaNormalizer.Chave(d.SiglaOriginal) && r.ContextoChave == SiglaNormalizer.ChaveContexto(d.ContextoTipo, d.ContextoValor)))
+            throw new RegraDuplicadaException(d.SiglaOriginal, d.ContextoTipo);
+        var agora = DateTime.UtcNow;
+        var r = new RegraSigla(++_id, d.SiglaOriginal, d.DisciplinaCanonica, d.ContextoTipo, d.ContextoValor, d.Ativo, origem, imp, 1, agora, usuario, agora, usuario);
+        Regras.Add(r);
+        Auditoria.Add((r.Id, "INCLUIR", null, r, imp, usuario));
+        return r;
+    }
+
+    private RegraSigla Atualizar(long id, int versao, DadosRegra d, long? imp, string usuario)
+    {
+        var i = Regras.FindIndex(r => r.Id == id);
+        if (i < 0) throw new RegraNaoEncontradaException(id);
+        var antes = Regras[i];
+        if (antes.Versao != versao) throw new ConcorrenciaException();
+        var depois = antes with { SiglaOriginal = d.SiglaOriginal, DisciplinaCanonica = d.DisciplinaCanonica, ContextoTipo = d.ContextoTipo,
+            ContextoValor = d.ContextoValor, Ativo = d.Ativo, ImportacaoId = imp ?? antes.ImportacaoId, Versao = antes.Versao + 1,
+            AlteradoEm = DateTime.UtcNow, AlteradoPor = usuario };
+        Regras[i] = depois;
+        Auditoria.Add((id, "ALTERAR", antes, depois, imp, usuario));
+        return depois;
+    }
+
+    public Task<RegraSigla> CriarAsync(DadosRegra dados, string usuario, CancellationToken ct)
+    {
+        Garantir();
+        lock (_lock) return Task.FromResult(Inserir(dados, "MANUAL", null, usuario));
+    }
+
+    public Task<RegraSigla> AtualizarAsync(long id, int versao, DadosRegra dados, string usuario, CancellationToken ct)
+    {
+        Garantir();
+        lock (_lock) return Task.FromResult(Atualizar(id, versao, dados, null, usuario));
+    }
+
+    public Task ExcluirAsync(long id, int versao, string usuario, CancellationToken ct)
+    {
+        Garantir();
+        lock (_lock)
+        {
+            var r = Regras.FirstOrDefault(x => x.Id == id) ?? throw new RegraNaoEncontradaException(id);
+            if (r.Versao != versao) throw new ConcorrenciaException();
+            Auditoria.Add((id, "EXCLUIR", r, null, null, usuario));
+            Regras.Remove(r);
+        }
+        return Task.CompletedTask;
+    }
+
+    public Task<ResultadoImportacao> AplicarImportacaoAsync(Func<IReadOnlyList<RegraSigla>, PlanoImportacao> planejar, string nomeArquivo,
+        string hashSha256, string usuario, CancellationToken ct)
+    {
+        Garantir();
+        lock (_lock)
+        {
+            var plano = planejar(Regras.ToList());
+            var imp = ++_imp;
+            foreach (var l in plano.Linhas)
+            {
+                var d = new DadosRegra(l.SiglaOriginal!, l.DisciplinaCanonica!, l.ContextoTipo, l.ContextoValor, l.Ativo ?? true);
+                if (l.Acao == AcaoImportacao.Incluir) Inserir(d, "IMPORTACAO", imp, usuario);
+                else if (l.Acao == AcaoImportacao.Alterar)
+                {
+                    var atual = Regras.First(r => r.Id == l.RegraExistenteId);
+                    Atualizar(atual.Id, atual.Versao, d, imp, usuario);
+                }
+            }
+            var s = plano.Resumo;
+            Importacoes.Add(new ImportacaoRegistrada(imp, nomeArquivo, hashSha256, plano.Aba, s.Incluidas, s.Alteradas, s.Inalteradas, s.Rejeitadas,
+                s.Duplicadas, DateTime.UtcNow, usuario));
+            return Task.FromResult(new ResultadoImportacao(imp, s, plano.Linhas));
+        }
+    }
+
+    public Task<IReadOnlyList<ImportacaoRegistrada>> ListarImportacoesAsync(int maximo, CancellationToken ct) =>
+        Task.FromResult<IReadOnlyList<ImportacaoRegistrada>>(Importacoes.AsEnumerable().Reverse().Take(maximo).ToList());
+}
diff --git a/Tests/NA_Connect.DisciplineAlias.Tests/ContratoTests.cs b/Tests/NA_Connect.DisciplineAlias.Tests/ContratoTests.cs
new file mode 100644
index 0000000..b696b3a
--- /dev/null
+++ b/Tests/NA_Connect.DisciplineAlias.Tests/ContratoTests.cs
@@ -0,0 +1,100 @@
+using System.Reflection;
+using System.Text.RegularExpressions;
+using APS.WebApp.Controllers;
+using APS.WebApp.Services.DisciplineAlias;
+using APS.WebApp.Services.Permissions;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.Extensions.Logging.Abstractions;
+
+namespace NA_Connect.DisciplineAlias.Tests;
+
+public sealed class ContratoTests
+{
+    private static string Sql(string arquivo) => File.ReadAllText(Path.Combine(AppContext.BaseDirectory, "Sql", arquivo));
+    private static readonly Regex Objeto = new(@"\b(?:INTO|FROM|UPDATE|JOIN|TABLE|REFERENCES|OBJECT_ID\(N')\s*([A-Za-z_\[\]]+)\.([A-Za-z_\[\]]+)", RegexOptions.IgnoreCase);
+
+    public static IEnumerable<object[]> ComandosDoStore() => typeof(SqlSiglaDisciplinaStore)
+        .GetFields(BindingFlags.Public | BindingFlags.Static).Where(f => f.IsLiteral && f.Name.StartsWith("Sql"))
+        .Select(f => new object[] { f.Name });
+
+    [Theory]
+    [MemberData(nameof(ComandosDoStore))]
+    public void Store_so_acessa_o_schema_normalizador(string campo)
+    {
+        var sql = (string)typeof(SqlSiglaDisciplinaStore).GetField(campo)!.GetRawConstantValue()!;
+        var objetos = Objeto.Matches(sql).Select(m => m.Groups[1].Value.Trim('[', ']')).ToList();
+        Assert.NotEmpty(objetos);
+        Assert.All(objetos, s => Assert.Equal("normalizador", s, ignoreCase: true));
+        Assert.DoesNotMatch(new Regex(@"\b(DROP|ALTER|TRUNCATE|MERGE)\b", RegexOptions.IgnoreCase), sql);
+    }
+
+    [Fact]
+    public void Migracao_up_e_aditiva_idempotente_e_sem_seed()
+    {
+        var up = Sql("20261019_001_NormalizadorSiglas_UP.sql");
+        Assert.DoesNotMatch(new Regex(@"\b(DROP|ALTER|TRUNCATE|DELETE|UPDATE|MERGE|INSERT)\b", RegexOptions.IgnoreCase), up);
+        Assert.All(Objeto.Matches(up).Select(m => m.Groups[1].Value), s => Assert.Equal("normalizador", s, ignoreCase: true));
+        foreach (var t in new[] { "Importacao", "SiglaDisciplina", "SiglaDisciplinaAuditoria" })
+            Assert.Contains($"IF OBJECT_ID(N'normalizador.{t}', N'U') IS NULL", up);
+        Assert.Contains("IF SCHEMA_ID(N'normalizador') IS NULL", up);
+        Assert.Contains("UNIQUE (SiglaChave, ContextoChave)", up);
+    }
+
+    [Fact]
+    public void Migracao_down_so_remove_objetos_proprios_e_protege_dados()
+    {
+        var down = Sql("20261019_001_NormalizadorSiglas_DOWN.sql");
+        var drops = Regex.Matches(down, @"DROP\s+(TABLE|SCHEMA)\s+([\w.]+)", RegexOptions.IgnoreCase).Select(m => m.Groups[2].Value).ToList();
+        Assert.Equal(["normalizador.SiglaDisciplinaAuditoria", "normalizador.SiglaDisciplina", "normalizador.Importacao", "normalizador"], drops);
+        Assert.Contains("@ConfirmoExportacao bit = 0", down);
+        Assert.Contains("Rollback recusado", down);
+        Assert.DoesNotMatch(new Regex(@"\bALTER\b|\bdbo\.", RegexOptions.IgnoreCase), down);
+    }
+
+    [Fact]
+    public void Edicao_exige_permissao_de_configuracao_existente_e_leitura_aceita_painel()
+    {
+        RequirePermissionAttribute Attr(string metodo) => typeof(DisciplineAliasController).GetMethod(metodo)!.GetCustomAttribute<RequirePermissionAttribute>()!;
+        foreach (var m in new[] { "Criar", "Atualizar", "DefinirAtivo", "Excluir", "Previa", "Confirmar" })
+            Assert.Equal(["settings.projects.edit"], Attr(m).Keys);
+        Assert.Contains("settings.projects.view", Attr("Listar").Keys);
+        Assert.Contains("reports.gestao.view", Attr("Ativas").Keys);
+        Assert.True(Attr("Ativas").AnyProject);
+    }
+
+    private sealed class Permissoes(CurrentPermissionUser? usuario) : IPermissionService
+    {
+        public bool Enforced => true;
+        public Task<PermissionCheck> CheckAsync(IReadOnlyCollection<string> anyOfKeys, string? projectIdAcc, CancellationToken ct, bool anyProject = false) =>
+            Task.FromResult(PermissionCheck.Allowed);
+        public Task<EffectivePermissions> GetEffectiveAsync(string? projectIdAcc, CancellationToken ct) => throw new NotSupportedException();
+        public Task<CurrentPermissionUser?> GetCurrentUserAsync(CancellationToken ct) => Task.FromResult(usuario);
+        public Task<int?> ResolverProjetoIdAsync(string? projectIdAcc, CancellationToken ct) => Task.FromResult<int?>(null);
+    }
+
+    private static DisciplineAliasController Controller(MemoriaStore store, CurrentPermissionUser? usuario) =>
+        new(new SiglaDisciplinaService(store), new Permissoes(usuario), NullLogger<DisciplineAliasController>.Instance)
+        { ControllerContext = new ControllerContext { HttpContext = new DefaultHttpContext() } };
+
+    private static readonly CurrentPermissionUser Eu = new(1, "acc", "teste@fixture.local", "Teste", false);
+
+    [Fact]
+    public async Task Controller_sem_migracao_responde_503_com_instalado_false()
+    {
+        var r = Assert.IsType<ObjectResult>(await Controller(new MemoriaStore { Instalado = false }, Eu).Listar(default));
+        Assert.Equal(503, r.StatusCode);
+        Assert.Contains("instalado = False", r.Value!.ToString());
+    }
+
+    [Fact]
+    public async Task Controller_mapeia_duplicada_para_409_invalida_para_400_e_sem_sessao_401()
+    {
+        var store = new MemoriaStore();
+        var c = Controller(store, Eu);
+        Assert.IsType<OkObjectResult>(await c.Criar(new SalvarRegraSigla("XA", "Teste", null, null, true, 0), default));
+        Assert.IsType<ConflictObjectResult>(await c.Criar(new SalvarRegraSigla(" xa", "Outro", null, null, true, 0), default));
+        Assert.IsType<BadRequestObjectResult>(await c.Criar(new SalvarRegraSigla("", "Teste", null, null, true, 0), default));
+        Assert.IsType<UnauthorizedObjectResult>(await Controller(store, null).Criar(new SalvarRegraSigla("XB", "T", null, null, true, 0), default));
+        Assert.Equal("teste@fixture.local", store.Regras.Single().CriadoPor);
+    }
+}
