+using System.Security.Cryptography;
+using OfficeOpenXml;
+
+namespace APS.WebApp.Services.DisciplineAlias;
+
+/// <summary>
+/// Leitura da planilha de mapeamento (EPPlus, já usado no projeto). Os cabeçalhos REAIS do arquivo são devolvidos e o
+/// usuário confirma qual coluna é sigla/disciplina/contexto/ativo — nenhum layout é presumido além da sugestão por nome exato.
+/// </summary>
+public static class SiglaPlanilhaReader
+{
+    public const long TamanhoMaximoBytes = 5 * 1024 * 1024;
+    public const int MaximoLinhas = 5000;
+
+    public static string Hash(byte[] conteudo) => Convert.ToHexString(SHA256.HashData(conteudo)).ToLowerInvariant();
+
+    public static PlanilhaLida Ler(byte[] conteudo, string? aba = null)
+    {
+        try { return LerPacote(conteudo, aba); }
+        catch (Exception ex) when (ex is not OutOfMemoryException)
+        {
+            return new PlanilhaLida(aba ?? "", [], [], [], ["Não foi possível ler a planilha (.xlsx inválido, corrompido ou protegido por senha)."]);
+        }
+    }
+
+    private static PlanilhaLida LerPacote(byte[] conteudo, string? aba)
+    {
+        using var ms = new MemoryStream(conteudo);
+        using var pacote = new ExcelPackage(ms);
+        var abas = pacote.Workbook.Worksheets.Select(w => w.Name).ToList();
+        if (abas.Count == 0) return new PlanilhaLida("", abas, [], [], ["Arquivo sem abas."]);
+        var ws = string.IsNullOrWhiteSpace(aba) ? pacote.Workbook.Worksheets[0] : pacote.Workbook.Worksheets[aba];
+        if (ws is null) return new PlanilhaLida(aba ?? "", abas, [], [], [$"Aba '{aba}' não encontrada."]);
+        if (ws.Dimension is null) return new PlanilhaLida(ws.Name, abas, [], [], ["Aba vazia."]);
+
+        int r0 = ws.Dimension.Start.Row, r1 = ws.Dimension.End.Row, c0 = ws.Dimension.Start.Column, c1 = ws.Dimension.End.Column;
+        string Celula(int r, int c) => SiglaNormalizer.Limpar(ws.Cells[r, c].Text);
+        // Cabeçalho = primeira linha com algum texto.
+        var linhaCab = Enumerable.Range(r0, r1 - r0 + 1).FirstOrDefault(r => Enumerable.Range(c0, c1 - c0 + 1).Any(c => Celula(r, c).Length > 0));
+        if (linhaCab == 0) return new PlanilhaLida(ws.Name, abas, [], [], ["Aba sem cabeçalho."]);
+
+        var erros = new List<string>();
+        var colunas = new List<(int Col, string Nome)>();
+        for (var c = c0; c <= c1; c++)
+        {
+            var nome = Celula(linhaCab, c);
+            if (nome.Length == 0) continue;
+            if (colunas.Any(x => SiglaNormalizer.Chave(x.Nome) == SiglaNormalizer.Chave(nome)))
+            {
+                erros.Add($"Cabeçalho '{nome}' repetido na linha {linhaCab}.");
+                continue;
+            }
+            colunas.Add((c, nome));
+        }
+        var linhas = new List<LinhaPlanilha>();
+        for (var r = linhaCab + 1; r <= r1; r++)
+        {
+            var celulas = colunas.ToDictionary(x => x.Nome, x => (string?)Celula(r, x.Col));
+            if (celulas.Values.All(string.IsNullOrEmpty)) continue;
+            if (linhas.Count >= MaximoLinhas)
+            {
+                erros.Add($"Arquivo com mais de {MaximoLinhas} linhas de dados; divida a planilha.");
+                break;
+            }
+            linhas.Add(new LinhaPlanilha(r, celulas));
+        }
+        return new PlanilhaLida(ws.Name, abas, colunas.Select(x => x.Nome).ToList(), linhas, erros);
+    }
+
+    /// <summary>
+    /// Sugestão de mapeamento SOMENTE por nome de cabeçalho exato (sem acento/caixa). Sempre exige confirmação na tela.
+    /// </summary>
+    public static MapeamentoColunas? Sugerir(IReadOnlyList<string> cabecalhos)
+    {
+        string? Achar(params string[] nomes) =>
+            cabecalhos.FirstOrDefault(h => nomes.Contains(SemAcento(SiglaNormalizer.Chave(h))));
+        var sigla = Achar("SIGLA", "SIGLA ORIGINAL");
+        var disciplina = Achar("DISCIPLINA CANONICA", "NOME CANONICO", "DISCIPLINA", "DISCIPLINA PT-BR", "NOME DA DISCIPLINA");
+        if (sigla is null || disciplina is null || sigla == disciplina) return null;
+        return new MapeamentoColunas(sigla, disciplina, Achar("TIPO DE CONTEXTO", "CONTEXTO TIPO"), Achar("CONTEXTO", "PROJETO", "FONTE"), Achar("ATIVO"));
+    }
+
+    private static string SemAcento(string s) =>
+        new(s.Normalize(System.Text.NormalizationForm.FormD).Where(ch => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch)
+            != System.Globalization.UnicodeCategory.NonSpacingMark).ToArray());
+}
+
+/// <summary>
+/// Planejamento puro (sem banco) da importação: classifica cada linha em Incluir / Alterar / Inalterada / Rejeitada /
+/// Duplicada. Idempotente: reimportar o mesmo arquivo dá tudo "Inalterada". Nunca exclui regra ausente do arquivo.
+/// Conflitos nunca são resolvidos em silêncio: mesma sigla+contexto com nomes diferentes NO ARQUIVO rejeita todas as
+/// linhas envolvidas; linha que muda a disciplina de regra EXISTENTE só é aplicada com aplicarAlteracoes=true.
+/// </summary>
+public static class SiglaImportacaoPlanner
+{
+    public static IReadOnlyList<string> ValidarMapeamento(MapeamentoColunas m, IReadOnlyList<string> cabecalhos)
+    {
+        var erros = new List<string>();
+        void Exigir(string? coluna, string papel, bool obrigatoria)
+        {
+            if (string.IsNullOrWhiteSpace(coluna)) { if (obrigatoria) erros.Add($"Selecione a coluna de {papel}."); return; }
+            if (!cabecalhos.Contains(coluna)) erros.Add($"Coluna '{coluna}' ({papel}) não existe no arquivo.");
+        }
+        Exigir(m.Sigla, "sigla", true);
+        Exigir(m.Disciplina, "disciplina canônica", true);
+        Exigir(m.ContextoTipo, "tipo de contexto", false);
+        Exigir(m.ContextoValor, "contexto", false);
+        Exigir(m.Ativo, "ativo", false);
+        var usadas = new[] { m.Sigla, m.Disciplina, m.ContextoTipo, m.ContextoValor, m.Ativo }.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
+        if (usadas.Count != usadas.Distinct().Count()) erros.Add("A mesma coluna foi escolhida para dois papéis.");
+        if (!string.IsNullOrWhiteSpace(m.ContextoValor) && string.IsNullOrWhiteSpace(m.ContextoTipo))
+            erros.Add("Coluna de contexto exige a coluna de tipo de contexto (PROJETO/FONTE).");
+        return erros;
+    }
+
+    public static bool? LerAtivo(string? valor, out bool valido)
+    {
+        valido = true;
+        var v = SiglaNormalizer.Chave(valor);
+        switch (v)
+        {
+            case "": return null;
+            case "1" or "SIM" or "S" or "TRUE" or "VERDADEIRO" or "ATIVO" or "ATIVA" or "X": return true;
+            case "0" or "NAO" or "NÃO" or "N" or "FALSE" or "FALSO" or "INATIVO" or "INATIVA": return false;
+            default: valido = false; return null;
+        }
+    }
+
+    public static PlanoImportacao Planejar(PlanilhaLida planilha, MapeamentoColunas m, IReadOnlyList<RegraSigla> existentes, bool aplicarAlteracoes)
+    {
+        string? Valor(LinhaPlanilha l, string? coluna) => coluna is null ? null : l.Celulas.GetValueOrDefault(coluna);
+        var porChave = existentes.ToDictionary(r => (r.SiglaChave, r.ContextoChave));
+
+        // 1) validação linha a linha
+        var validadas = planilha.Linhas.Select(l =>
+        {
+            var ativo = LerAtivo(Valor(l, m.Ativo), out var ativoValido);
+            var (regra, erros) = SiglaNormalizer.Validar(Valor(l, m.Sigla), Valor(l, m.Disciplina), Valor(l, m.ContextoTipo), Valor(l, m.ContextoValor), ativo ?? true);
+            if (!ativoValido) erros = [.. erros, $"Valor de ativo '{Valor(l, m.Ativo)}' não reconhecido (use SIM/NÃO)."];
+            return (Linha: l, Regra: ativoValido ? regra : null, Erros: erros, AtivoInformado: ativo);
+        }).ToList();
+
+        // 2) conflitos dentro do próprio arquivo (mesma sigla + contexto com nomes diferentes)
+        var conflitantes = validadas.Where(x => x.Regra is not null)
+            .GroupBy(x => (SiglaNormalizer.Chave(x.Regra!.SiglaOriginal), SiglaNormalizer.ChaveContexto(x.Regra.ContextoTipo, x.Regra.ContextoValor)))
+            .Where(g => g.Select(x => SiglaNormalizer.Chave(x.Regra!.DisciplinaCanonica)).Distinct().Count() > 1)
+            .ToDictionary(g => g.Key, g => string.Join(" / ", g.Select(x => x.Regra!.DisciplinaCanonica).Distinct()) + " (linhas " + string.Join(", ", g.Select(x => x.Linha.Numero)) + ")");
+
+        var vistas = new HashSet<(string, string)>();
+        var saida = new List<LinhaPlano>();
+        foreach (var (linha, regra, erros, ativoInformado) in validadas)
+        {
+            if (regra is null)
+            {
+                saida.Add(new LinhaPlano(linha.Numero, Valor(linha, m.Sigla), Valor(linha, m.Disciplina), Valor(linha, m.ContextoTipo),
+                    Valor(linha, m.ContextoValor), ativoInformado, AcaoImportacao.Rejeitada, string.Join(" ", erros)));
+                continue;
+            }
+            var chave = (SiglaNormalizer.Chave(regra.SiglaOriginal), SiglaNormalizer.ChaveContexto(regra.ContextoTipo, regra.ContextoValor));
+            LinhaPlano Plano(AcaoImportacao acao, string? motivo, RegraSigla? atual = null, bool conflito = false) =>
+                new(linha.Numero, regra.SiglaOriginal, regra.DisciplinaCanonica, regra.ContextoTipo, regra.ContextoValor, ativoInformado ?? atual?.Ativo ?? true,
+                    acao, motivo, conflito, atual?.Id, atual?.DisciplinaCanonica, atual?.Ativo);
+            if (conflitantes.TryGetValue(chave, out var detalhe))
+            {
+                saida.Add(Plano(AcaoImportacao.Rejeitada, $"Conflito no arquivo: mesma sigla e contexto com disciplinas diferentes — {detalhe}."));
+                continue;
+            }
+            if (!vistas.Add(chave))
+            {
+                saida.Add(Plano(AcaoImportacao.Duplicada, "Linha repetida no arquivo (mesma sigla, contexto e disciplina); considerada uma vez."));
+                continue;
+            }
+            if (!porChave.TryGetValue(chave, out var atual))
+            {
+                saida.Add(Plano(AcaoImportacao.Incluir, null));
+                continue;
+            }
+            var mudaNome = atual.DisciplinaCanonica != regra.DisciplinaCanonica;
+            var conflitoNome = SiglaNormalizer.Chave(atual.DisciplinaCanonica) != SiglaNormalizer.Chave(regra.DisciplinaCanonica);
+            var mudaAtivo = ativoInformado is bool a && a != atual.Ativo;
+            var mudaSigla = atual.SiglaOriginal != regra.SiglaOriginal;
+            if (!mudaNome && !mudaAtivo && !mudaSigla) { saida.Add(Plano(AcaoImportacao.Inalterada, null, atual)); continue; }
+            if (conflitoNome && !aplicarAlteracoes)
+            {
+                saida.Add(Plano(AcaoImportacao.Rejeitada,
+                    $"Conflito com regra existente: hoje '{atual.DisciplinaCanonica}', arquivo '{regra.DisciplinaCanonica}'. Marque \"aplicar alterações\" para substituir.",
+                    atual, conflito: true));
+                continue;
+            }
+            var mudancas = new List<string>();
+            if (mudaNome) mudancas.Add($"disciplina '{atual.DisciplinaCanonica}' → '{regra.DisciplinaCanonica}'");
+            if (mudaSigla) mudancas.Add($"grafia da sigla '{atual.SiglaOriginal}' → '{regra.SiglaOriginal}'");
+            if (mudaAtivo) mudancas.Add(ativoInformado == true ? "reativada" : "desativada");
+            saida.Add(Plano(AcaoImportacao.Alterar, string.Join("; ", mudancas), atual, conflito: conflitoNome));
+        }
+        return new PlanoImportacao(planilha.Aba, planilha.Cabecalhos, m, saida);
+    }
+}
diff --git a/Services/DisciplineAlias/SiglaNormalizer.cs b/Services/DisciplineAlias/SiglaNormalizer.cs
new file mode 100644
index 0000000..618099d
--- /dev/null
+++ b/Services/DisciplineAlias/SiglaNormalizer.cs
@@ -0,0 +1,96 @@
+using System.Text;
+using System.Text.RegularExpressions;
+
+namespace APS.WebApp.Services.DisciplineAlias;
+
+/// <summary>
+/// Função ÚNICA de normalização (espelhada em ClientApp/src/features/disciplinas/normalizadorSiglas.ts; os dois lados
+/// rodam os mesmos casos de Tests/NA_Connect.DisciplineAlias.Tests/Fixtures/casos_resolucao.json).
+/// Comparação: Unicode NFC, espaços colapsados, sem espaços nas pontas, caixa ignorada. Acentos NÃO são removidos
+/// (o nome canônico preserva Unicode; "ELÉTRICA" ≠ "ELETRICA" na comparação, para nunca unir por semelhança).
+/// </summary>
+public static partial class SiglaNormalizer
+{
+    public const int MaxSigla = 50;
+    public const int MaxDisciplina = 200;
+    public const int MaxContexto = 200;
+
+    [GeneratedRegex(@"\s+")]
+    private static partial Regex Espacos();
+
+    /// <summary>Texto para exibição/persistência: NFC, espaços colapsados e aparados; caixa e acentos preservados.</summary>
+    public static string Limpar(string? valor) =>
+        string.IsNullOrWhiteSpace(valor) ? "" : Espacos().Replace(valor.Normalize(NormalizationForm.FormC), " ").Trim();
+
+    /// <summary>Chave de comparação (sigla, nome, contexto).</summary>
+    public static string Chave(string? valor) => Limpar(valor).ToUpperInvariant();
+
+    public static string ChaveContexto(string? tipo, string? valor)
+    {
+        var t = Chave(tipo);
+        return t.Length == 0 ? "" : $"{t}:{Chave(valor)}";
+    }
+
+    /// <summary>Valida e limpa uma regra (inclusão manual, correção ou linha de importação). Nunca completa dado ausente.</summary>
+    public static (DadosRegra? Regra, IReadOnlyList<string> Erros) Validar(string? sigla, string? disciplina, string? contextoTipo,
+        string? contextoValor, bool ativo)
+    {
+        var erros = new List<string>();
+        var s = Limpar(sigla);
+        var d = Limpar(disciplina);
+        var t = Chave(contextoTipo);
+        var v = Limpar(contextoValor);
+        if (s.Length == 0) erros.Add("Sigla vazia.");
+        else if (s.Length > MaxSigla) erros.Add($"Sigla com mais de {MaxSigla} caracteres.");
+        if (d.Length == 0) erros.Add("Disciplina canônica vazia.");
+        else if (d.Length > MaxDisciplina) erros.Add($"Disciplina canônica com mais de {MaxDisciplina} caracteres.");
+        if (TemControle(s) || TemControle(d) || TemControle(v)) erros.Add("Texto com caractere de controle.");
+        if (t.Length == 0 && v.Length > 0) erros.Add("Contexto informado sem tipo (use PROJETO ou FONTE).");
+        if (t.Length > 0)
+        {
+            if (!ContextoTipos.Todos.Contains(t)) erros.Add($"Tipo de contexto '{Limpar(contextoTipo)}' inválido (use PROJETO ou FONTE).");
+            if (v.Length == 0) erros.Add("Tipo de contexto sem valor.");
+            else if (v.Length > MaxContexto) erros.Add($"Contexto com mais de {MaxContexto} caracteres.");
+            if (t == ContextoTipos.Fonte && v.Length > 0 && !FontesConhecidas.Todas.Contains(Chave(v)))
+                erros.Add($"Fonte '{v}' inválida (use {string.Join(", ", FontesConhecidas.Todas)}).");
+        }
+        if (erros.Count > 0) return (null, erros);
+        return (new DadosRegra(s, d, t.Length == 0 ? null : t, t.Length == 0 ? null : t == ContextoTipos.Fonte ? Chave(v) : v, ativo), erros);
+    }
+
+    private static bool TemControle(string s) => s.Any(char.IsControl);
+
+    /// <summary>
+    /// Resolve o nome de agregação de um item. Candidatos em ordem de preferência (ex.: sigla DOC3, nome da disciplina).
+    /// Prioridade: regra contexto-específica (projeto/fonte) → regra global → rótulo original. Duas regras ativas no
+    /// MESMO nível que apontam para nomes diferentes = conflito: NÃO é resolvido; devolve o rótulo original + diagnóstico.
+    /// </summary>
+    public static Resolucao Resolver(IEnumerable<RegraSigla> regras, IReadOnlyList<string?> candidatos, string rotuloOriginal,
+        ContextoResolucao contexto)
+    {
+        var ativas = regras.Where(r => r.Ativo).ToList();
+        var chaves = candidatos.Select(Chave).Where(c => c.Length > 0).Distinct().ToList();
+        var projetos = contexto.Projetos.Select(Chave).Where(c => c.Length > 0).ToHashSet();
+        var fonte = Chave(contexto.Fonte);
+        bool NoContexto(RegraSigla r) =>
+            r.ContextoTipo == ContextoTipos.Projeto && projetos.Contains(Chave(r.ContextoValor))
+            || r.ContextoTipo == ContextoTipos.Fonte && fonte.Length > 0 && Chave(r.ContextoValor) == fonte;
+
+        foreach (var (filtro, origem) in new (Func<RegraSigla, bool>, OrigemResolucao)[]
+                 { (NoContexto, OrigemResolucao.Contexto), (r => r.ContextoTipo is null, OrigemResolucao.Global) })
+        {
+            foreach (var chave in chaves)
+            {
+                var achadas = ativas.Where(r => r.SiglaChave == chave && filtro(r)).ToList();
+                if (achadas.Count == 0) continue;
+                var nomes = achadas.GroupBy(r => Chave(r.DisciplinaCanonica)).ToList();
+                if (nomes.Count > 1)
+                    return new Resolucao(Limpar(rotuloOriginal), OrigemResolucao.Original, null,
+                        $"Sigla '{achadas[0].SiglaOriginal}' com regras conflitantes ({string.Join(" / ", nomes.Select(g => g.First().DisciplinaCanonica))}); mantido o rótulo original.");
+                var regra = achadas.OrderBy(r => r.Id).First();
+                return new Resolucao(Limpar(regra.DisciplinaCanonica), origem, regra.Id, null);
+            }
+        }
+        return new Resolucao(Limpar(rotuloOriginal), OrigemResolucao.Original, null, null);
+    }
+}
diff --git a/Services/DisciplineAlias/SqlSiglaDisciplinaStore.cs b/Services/DisciplineAlias/SqlSiglaDisciplinaStore.cs
new file mode 100644
index 0000000..6f7741e
--- /dev/null
+++ b/Services/DisciplineAlias/SqlSiglaDisciplinaStore.cs
@@ -0,0 +1,274 @@
+using System.Data;
+using System.Text.Json;
+using Microsoft.Data.SqlClient;
+
+namespace APS.WebApp.Services.DisciplineAlias;
+
+/// <summary>
+/// SQL Server: SOMENTE objetos do schema normalizador (Migrations/Normalizador). Nenhuma leitura/escrita em tabela legada.
+/// Toda mudança grava uma linha em normalizador.SiglaDisciplinaAuditoria (antes/depois em JSON) na mesma transação.
+/// </summary>
+public sealed class SqlSiglaDisciplinaStore(IConfiguration configuration) : ISiglaDisciplinaStore
+{
+    private const string Colunas = """
+        Id, SiglaOriginal, DisciplinaCanonica, ContextoTipo, ContextoValor, Ativo, Origem, ImportacaoId, Versao,
+        CriadoEm, CriadoPor, AlteradoEm, AlteradoPor
+        """;
+    public const string SqlInstalado = "SELECT CASE WHEN OBJECT_ID(N'normalizador.SiglaDisciplina', N'U') IS NULL OR OBJECT_ID(N'normalizador.SiglaDisciplinaAuditoria', N'U') IS NULL OR OBJECT_ID(N'normalizador.Importacao', N'U') IS NULL THEN 0 ELSE 1 END;";
+    public const string SqlListar = $"SELECT {Colunas} FROM normalizador.SiglaDisciplina ORDER BY SiglaChave, ContextoChave;";
+    public const string SqlListarBloqueando = $"SELECT {Colunas} FROM normalizador.SiglaDisciplina WITH (UPDLOCK, HOLDLOCK) ORDER BY SiglaChave, ContextoChave;";
+    public const string SqlUma = $"SELECT {Colunas} FROM normalizador.SiglaDisciplina WITH (UPDLOCK, HOLDLOCK) WHERE Id = @Id;";
+    public const string SqlInserir = """
+        INSERT INTO normalizador.SiglaDisciplina
+            (SiglaOriginal, SiglaChave, DisciplinaCanonica, ContextoTipo, ContextoValor, ContextoChave, Ativo, Origem, ImportacaoId,
+             Versao, CriadoEm, CriadoPor, AlteradoEm, AlteradoPor)
+        OUTPUT INSERTED.Id
+        VALUES (@SiglaOriginal, @SiglaChave, @DisciplinaCanonica, @ContextoTipo, @ContextoValor, @ContextoChave, @Ativo, @Origem, @ImportacaoId,
+             1, SYSUTCDATETIME(), @Usuario, SYSUTCDATETIME(), @Usuario);
+        """;
+    public const string SqlAtualizar = """
+        UPDATE normalizador.SiglaDisciplina
+           SET SiglaOriginal = @SiglaOriginal, SiglaChave = @SiglaChave, DisciplinaCanonica = @DisciplinaCanonica,
+               ContextoTipo = @ContextoTipo, ContextoValor = @ContextoValor, ContextoChave = @ContextoChave, Ativo = @Ativo,
+               ImportacaoId = COALESCE(@ImportacaoId, ImportacaoId), Versao = Versao + 1, AlteradoEm = SYSUTCDATETIME(), AlteradoPor = @Usuario
+         WHERE Id = @Id AND Versao = @Versao;
+        """;
+    public const string SqlExcluir = "DELETE FROM normalizador.SiglaDisciplina WHERE Id = @Id AND Versao = @Versao;";
+    public const string SqlAuditar = """
+        INSERT INTO normalizador.SiglaDisciplinaAuditoria (RegraId, Acao, AntesJson, DepoisJson, ImportacaoId, Usuario, DataHora)
+        VALUES (@RegraId, @Acao, @AntesJson, @DepoisJson, @ImportacaoId, @Usuario, SYSUTCDATETIME());
+        """;
+    public const string SqlRegistrarImportacao = """
+        INSERT INTO normalizador.Importacao (NomeArquivo, HashSha256, Aba, MapeamentoJson, Incluidas, Alteradas, Inalteradas, Rejeitadas,
+            Duplicadas, RelatorioJson, ImportadoEm, ImportadoPor)
+        OUTPUT INSERTED.Id
+        VALUES (@NomeArquivo, @Hash, @Aba, @MapeamentoJson, 0, 0, 0, 0, 0, N'[]', SYSUTCDATETIME(), @Usuario);
+        """;
+    public const string SqlFecharImportacao = """
+        UPDATE normalizador.Importacao SET Incluidas = @Incluidas, Alteradas = @Alteradas, Inalteradas = @Inalteradas, Rejeitadas = @Rejeitadas,
+            Duplicadas = @Duplicadas, RelatorioJson = @RelatorioJson WHERE Id = @Id;
+        """;
+    public const string SqlListarImportacoes = """
+        SELECT TOP (@Max) Id, NomeArquivo, HashSha256, Aba, Incluidas, Alteradas, Inalteradas, Rejeitadas, Duplicadas, ImportadoEm, ImportadoPor
+        FROM normalizador.Importacao ORDER BY Id DESC;
+        """;
+
+    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
+
+    private async Task<SqlConnection> AbrirAsync(CancellationToken ct)
+    {
+        var c = new SqlConnection(configuration.GetConnectionString("LocalConnection")
+            ?? throw new InvalidOperationException("Conexão indisponível."));
+        await c.OpenAsync(ct);
+        return c;
+    }
+
+    public async Task<bool> InstaladoAsync(CancellationToken ct)
+    {
+        await using var c = await AbrirAsync(ct);
+        using var cmd = new SqlCommand(SqlInstalado, c);
+        return Convert.ToInt32(await cmd.ExecuteScalarAsync(ct)) == 1;
+    }
+
+    private async Task GarantirInstaladoAsync(SqlConnection c, SqlTransaction? tx, CancellationToken ct)
+    {
+        using var cmd = new SqlCommand(SqlInstalado, c, tx);
+        if (Convert.ToInt32(await cmd.ExecuteScalarAsync(ct)) != 1) throw new NormalizadorNaoInstaladoException();
+    }
+
+    public async Task<IReadOnlyList<RegraSigla>> ListarAsync(CancellationToken ct)
+    {
+        await using var c = await AbrirAsync(ct);
+        await GarantirInstaladoAsync(c, null, ct);
+        return await LerAsync(new SqlCommand(SqlListar, c), ct);
+    }
+
+    private static async Task<List<RegraSigla>> LerAsync(SqlCommand cmd, CancellationToken ct)
+    {
+        using (cmd)
+        {
+            await using var r = await cmd.ExecuteReaderAsync(ct);
+            var lista = new List<RegraSigla>();
+            while (await r.ReadAsync(ct))
+                lista.Add(new RegraSigla(r.GetInt64(0), r.GetString(1), r.GetString(2), r.IsDBNull(3) ? null : r.GetString(3),
+                    r.IsDBNull(4) ? null : r.GetString(4), r.GetBoolean(5), r.GetString(6), r.IsDBNull(7) ? null : r.GetInt64(7),
+                    r.GetInt32(8), r.GetDateTime(9), r.GetString(10), r.GetDateTime(11), r.GetString(12)));
+            return lista;
+        }
+    }
+
+    private static async Task<RegraSigla?> UmaAsync(SqlConnection c, SqlTransaction tx, long id, CancellationToken ct)
+    {
+        var cmd = new SqlCommand(SqlUma, c, tx);
+        cmd.Parameters.Add("@Id", SqlDbType.BigInt).Value = id;
+        return (await LerAsync(cmd, ct)).FirstOrDefault();
+    }
+
+    private static void Parametros(SqlCommand cmd, DadosRegra d, string usuario, long? importacaoId)
+    {
+        cmd.Parameters.Add("@SiglaOriginal", SqlDbType.NVarChar, SiglaNormalizer.MaxSigla).Value = d.SiglaOriginal;
+        cmd.Parameters.Add("@SiglaChave", SqlDbType.NVarChar, SiglaNormalizer.MaxSigla).Value = SiglaNormalizer.Chave(d.SiglaOriginal);
+        cmd.Parameters.Add("@DisciplinaCanonica", SqlDbType.NVarChar, SiglaNormalizer.MaxDisciplina).Value = d.DisciplinaCanonica;
+        cmd.Parameters.Add("@ContextoTipo", SqlDbType.VarChar, 10).Value = (object?)d.ContextoTipo ?? DBNull.Value;
+        cmd.Parameters.Add("@ContextoValor", SqlDbType.NVarChar, SiglaNormalizer.MaxContexto).Value = (object?)d.ContextoValor ?? DBNull.Value;
+        cmd.Parameters.Add("@ContextoChave", SqlDbType.NVarChar, 220).Value = SiglaNormalizer.ChaveContexto(d.ContextoTipo, d.ContextoValor);
+        cmd.Parameters.Add("@Ativo", SqlDbType.Bit).Value = d.Ativo;
+        cmd.Parameters.Add("@ImportacaoId", SqlDbType.BigInt).Value = (object?)importacaoId ?? DBNull.Value;
+        cmd.Parameters.Add("@Usuario", SqlDbType.NVarChar, 320).Value = usuario;
+    }
+
+    private static async Task AuditarAsync(SqlConnection c, SqlTransaction tx, long regraId, string acao, object? antes, object? depois,
+        long? importacaoId, string usuario, CancellationToken ct)
+    {
+        using var cmd = new SqlCommand(SqlAuditar, c, tx);
+        cmd.Parameters.Add("@RegraId", SqlDbType.BigInt).Value = regraId;
+        cmd.Parameters.Add("@Acao", SqlDbType.VarChar, 12).Value = acao;
+        cmd.Parameters.Add("@AntesJson", SqlDbType.NVarChar, -1).Value = antes is null ? DBNull.Value : JsonSerializer.Serialize(antes, Json);
+        cmd.Parameters.Add("@DepoisJson", SqlDbType.NVarChar, -1).Value = depois is null ? DBNull.Value : JsonSerializer.Serialize(depois, Json);
+        cmd.Parameters.Add("@ImportacaoId", SqlDbType.BigInt).Value = (object?)importacaoId ?? DBNull.Value;
+        cmd.Parameters.Add("@Usuario", SqlDbType.NVarChar, 320).Value = usuario;
+        await cmd.ExecuteNonQueryAsync(ct);
+    }
+
+    private static async Task<long> InserirAsync(SqlConnection c, SqlTransaction tx, DadosRegra d, string origem, long? importacaoId,
+        string usuario, CancellationToken ct)
+    {
+        using var cmd = new SqlCommand(SqlInserir, c, tx);
+        Parametros(cmd, d, usuario, importacaoId);
+        cmd.Parameters.Add("@Origem", SqlDbType.VarChar, 12).Value = origem;
+        try { return Convert.ToInt64(await cmd.ExecuteScalarAsync(ct)); }
+        catch (SqlException ex) when (ex.Number is 2627 or 2601)
+        {
+            throw new RegraDuplicadaException(d.SiglaOriginal, SiglaNormalizer.ChaveContexto(d.ContextoTipo, d.ContextoValor));
+        }
+    }
+
+    private static async Task AtualizarLinhaAsync(SqlConnection c, SqlTransaction tx, long id, int versao, DadosRegra d, long? importacaoId,
+        string usuario, CancellationToken ct)
+    {
+        using var cmd = new SqlCommand(SqlAtualizar, c, tx);
+        Parametros(cmd, d, usuario, importacaoId);
+        cmd.Parameters.Add("@Id", SqlDbType.BigInt).Value = id;
+        cmd.Parameters.Add("@Versao", SqlDbType.Int).Value = versao;
+        int n;
+        try { n = await cmd.ExecuteNonQueryAsync(ct); }
+        catch (SqlException ex) when (ex.Number is 2627 or 2601)
+        {
+            throw new RegraDuplicadaException(d.SiglaOriginal, SiglaNormalizer.ChaveContexto(d.ContextoTipo, d.ContextoValor));
+        }
+        if (n != 1) throw new ConcorrenciaException();
+    }
+
+    private static string AcaoDe(RegraSigla antes, DadosRegra depois) =>
+        antes.SiglaOriginal == depois.SiglaOriginal && antes.DisciplinaCanonica == depois.DisciplinaCanonica
+        && antes.ContextoTipo == depois.ContextoTipo && antes.ContextoValor == depois.ContextoValor && antes.Ativo != depois.Ativo
+            ? depois.Ativo ? "ATIVAR" : "DESATIVAR"
+            : "ALTERAR";
+
+    public async Task<RegraSigla> CriarAsync(DadosRegra dados, string usuario, CancellationToken ct)
+    {
+        await using var c = await AbrirAsync(ct);
+        await using var tx = (SqlTransaction)await c.BeginTransactionAsync(IsolationLevel.Serializable, ct);
+        await GarantirInstaladoAsync(c, tx, ct);
+        var id = await InserirAsync(c, tx, dados, "MANUAL", null, usuario, ct);
+        var nova = (await UmaAsync(c, tx, id, ct))!;
+        await AuditarAsync(c, tx, id, "INCLUIR", null, nova, null, usuario, ct);
+        await tx.CommitAsync(ct);
+        return nova;
+    }
+
+    public async Task<RegraSigla> AtualizarAsync(long id, int versao, DadosRegra dados, string usuario, CancellationToken ct)
+    {
+        await using var c = await AbrirAsync(ct);
+        await using var tx = (SqlTransaction)await c.BeginTransactionAsync(IsolationLevel.Serializable, ct);
+        await GarantirInstaladoAsync(c, tx, ct);
+        var antes = await UmaAsync(c, tx, id, ct) ?? throw new RegraNaoEncontradaException(id);
+        if (antes.Versao != versao) throw new ConcorrenciaException();
+        await AtualizarLinhaAsync(c, tx, id, versao, dados, null, usuario, ct);
+        var depois = (await UmaAsync(c, tx, id, ct))!;
+        await AuditarAsync(c, tx, id, AcaoDe(antes, dados), antes, depois, null, usuario, ct);
+        await tx.CommitAsync(ct);
+        return depois;
+    }
+
+    public async Task ExcluirAsync(long id, int versao, string usuario, CancellationToken ct)
+    {
+        await using var c = await AbrirAsync(ct);
+        await using var tx = (SqlTransaction)await c.BeginTransactionAsync(IsolationLevel.Serializable, ct);
+        await GarantirInstaladoAsync(c, tx, ct);
+        var antes = await UmaAsync(c, tx, id, ct) ?? throw new RegraNaoEncontradaException(id);
+        // A auditoria guarda o retrato completo ANTES da exclusão (nenhum dado se perde).
+        await AuditarAsync(c, tx, id, "EXCLUIR", antes, null, null, usuario, ct);
+        using var cmd = new SqlCommand(SqlExcluir, c, tx);
+        cmd.Parameters.Add("@Id", SqlDbType.BigInt).Value = id;
+        cmd.Parameters.Add("@Versao", SqlDbType.Int).Value = versao;
+        if (await cmd.ExecuteNonQueryAsync(ct) != 1) throw new ConcorrenciaException();
+        await tx.CommitAsync(ct);
+    }
+
+    public async Task<ResultadoImportacao> AplicarImportacaoAsync(Func<IReadOnlyList<RegraSigla>, PlanoImportacao> planejar, string nomeArquivo,
+        string hashSha256, string usuario, CancellationToken ct)
+    {
+        await using var c = await AbrirAsync(ct);
+        await using var tx = (SqlTransaction)await c.BeginTransactionAsync(IsolationLevel.Serializable, ct);
+        await GarantirInstaladoAsync(c, tx, ct);
+        var atuais = await LerAsync(new SqlCommand(SqlListarBloqueando, c, tx), ct);
+        var plano = planejar(atuais);
+
+        long importacaoId;
+        using (var cmd = new SqlCommand(SqlRegistrarImportacao, c, tx))
+        {
+            cmd.Parameters.Add("@NomeArquivo", SqlDbType.NVarChar, 260).Value = Path.GetFileName(nomeArquivo);
+            cmd.Parameters.Add("@Hash", SqlDbType.Char, 64).Value = hashSha256;
+            cmd.Parameters.Add("@Aba", SqlDbType.NVarChar, 128).Value = plano.Aba;
+            cmd.Parameters.Add("@MapeamentoJson", SqlDbType.NVarChar, -1).Value = JsonSerializer.Serialize(plano.Mapeamento, Json);
+            cmd.Parameters.Add("@Usuario", SqlDbType.NVarChar, 320).Value = usuario;
+            importacaoId = Convert.ToInt64(await cmd.ExecuteScalarAsync(ct));
+        }
+        var porId = atuais.ToDictionary(r => r.Id);
+        foreach (var l in plano.Linhas)
+        {
+            if (l.Acao is not (AcaoImportacao.Incluir or AcaoImportacao.Alterar)) continue;
+            var dados = new DadosRegra(l.SiglaOriginal!, l.DisciplinaCanonica!, l.ContextoTipo, l.ContextoValor, l.Ativo ?? true);
+            if (l.Acao == AcaoImportacao.Incluir)
+            {
+                var id = await InserirAsync(c, tx, dados, "IMPORTACAO", importacaoId, usuario, ct);
+                await AuditarAsync(c, tx, id, "INCLUIR", null, await UmaAsync(c, tx, id, ct), importacaoId, usuario, ct);
+            }
+            else
+            {
+                var antes = porId[l.RegraExistenteId!.Value];
+                await AtualizarLinhaAsync(c, tx, antes.Id, antes.Versao, dados, importacaoId, usuario, ct);
+                await AuditarAsync(c, tx, antes.Id, AcaoDe(antes, dados), antes, await UmaAsync(c, tx, antes.Id, ct), importacaoId, usuario, ct);
+            }
+        }
+        var resumo = plano.Resumo;
+        using (var cmd = new SqlCommand(SqlFecharImportacao, c, tx))
+        {
+            cmd.Parameters.Add("@Id", SqlDbType.BigInt).Value = importacaoId;
+            cmd.Parameters.Add("@Incluidas", SqlDbType.Int).Value = resumo.Incluidas;
+            cmd.Parameters.Add("@Alteradas", SqlDbType.Int).Value = resumo.Alteradas;
+            cmd.Parameters.Add("@Inalteradas", SqlDbType.Int).Value = resumo.Inalteradas;
+            cmd.Parameters.Add("@Rejeitadas", SqlDbType.Int).Value = resumo.Rejeitadas;
+            cmd.Parameters.Add("@Duplicadas", SqlDbType.Int).Value = resumo.Duplicadas;
+            cmd.Parameters.Add("@RelatorioJson", SqlDbType.NVarChar, -1).Value = JsonSerializer.Serialize(plano.Linhas, Json);
+            await cmd.ExecuteNonQueryAsync(ct);
+        }
+        await tx.CommitAsync(ct);
+        return new ResultadoImportacao(importacaoId, resumo, plano.Linhas);
+    }
+
+    public async Task<IReadOnlyList<ImportacaoRegistrada>> ListarImportacoesAsync(int maximo, CancellationToken ct)
+    {
+        await using var c = await AbrirAsync(ct);
+        await GarantirInstaladoAsync(c, null, ct);
+        using var cmd = new SqlCommand(SqlListarImportacoes, c);
+        cmd.Parameters.Add("@Max", SqlDbType.Int).Value = maximo;
+        await using var r = await cmd.ExecuteReaderAsync(ct);
+        var lista = new List<ImportacaoRegistrada>();
+        while (await r.ReadAsync(ct))
+            lista.Add(new ImportacaoRegistrada(r.GetInt64(0), r.GetString(1), r.GetString(2), r.GetString(3), r.GetInt32(4), r.GetInt32(5),
+                r.GetInt32(6), r.GetInt32(7), r.GetInt32(8), r.GetDateTime(9), r.GetString(10)));
+        return lista;
+    }
+}
