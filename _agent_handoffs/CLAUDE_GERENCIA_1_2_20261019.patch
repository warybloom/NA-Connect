+}
+export function agrupar<T>(itens:readonly T[],chave:(x:T)=>string){
+ const m=new Map<string,T[]>();for(const x of itens){const k=chave(x);if(!m.has(k))m.set(k,[]);m.get(k)!.push(x);}return m;
+}
