<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ferramenta de VALIDAÇÃO somente leitura (não faz parte do app): lê um .mpp com o mesmo MPXJ.Net do importador
       e grava JSON com os campos que o BI CHS001 precisa. Nunca acessa banco, ACC ou rede. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MPXJ.Net" Version="13.5.0" />
  </ItemGroup>
</Project>
