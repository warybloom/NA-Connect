@using System.Text.Json
@model JsonElement

@{
    ViewData["Title"] = "Pastas Principais";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Hubs", "Home")">Minhas Contas</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Projetos", "Home", new { hubId = ViewBag.HubId })">Projetos</a></li>
            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
        </ol>
    </nav>

    <h3>@ViewData["Title"]</h3>
    <p class="text-muted">Selecione "Arquivos de Projeto" para ver a estrutura de pastas do ACC.</p>
    <hr />

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
    <div class="alert alert-warning">@ViewBag.ErrorMessage</div>
    }
    else if (Model.TryGetProperty("data", out var folders) && folders.ValueKind == JsonValueKind.Array && folders.EnumerateArray().Any())
    {
    <div class="list-group">
        @foreach (var folder in folders.EnumerateArray())
            {
                var folderName = folder.GetProperty("attributes").GetProperty("displayName").GetString();
                var folderId = folder.GetProperty("id").GetString();

        <a href="@Url.Action("ConteudoPasta", "Home", new { hubId = ViewBag.HubId, projectId = ViewBag.ProjectId, folderId = folderId })" class="list-group-item list-group-item-action fs-5">
            📁 @folderName
        </a>
            }
    </div>
    }
    else
    {
    <p class="text-muted">Nenhuma pasta encontrada.</p>
    }
</div>