@using System.Text.Json
@model JsonElement

@{
    ViewData["Title"] = "Minhas Contas / Hubs";
    Layout = "~/Views/Shared/_Layout.cshtml"; // <-- FORÇA O USO DO LAYOUT CORRETO
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Selecione uma Conta (Hub)</h2>
        <a class="btn btn-outline-secondary" href="@Url.Action("Logout", "OAuth", new { area = "Authentication" })">Sair</a>
    </div>
    <p class="text-muted">Estas são as contas (BIM 360 / ACC) às quais você tem acesso.</p>
    <hr />

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }
    else if (Model.TryGetProperty("data", out var hubs) && hubs.ValueKind == JsonValueKind.Array && hubs.EnumerateArray().Any())
    {
        <div class="list-group">
            @foreach (var hub in hubs.EnumerateArray())
            {
                var hubName = hub.TryGetProperty("attributes", out var attr) && attr.TryGetProperty("name", out var name) ? name.GetString() : "[Hub sem nome]";
                var hubId = hub.TryGetProperty("id", out var id) ? id.GetString() : "";

                if (!string.IsNullOrEmpty(hubId))
                {
                    <a href="@Url.Action("Projetos", "Data", new { hubId = hubId })" class="list-group-item list-group-item-action fs-5">
                        <i class="fas fa-cloud me-2"></i> @hubName
                    </a>
                }
            }
        </div>
    }
    else
    {
        <p>Nenhum Hub encontrado para este usuário.</p>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}