@using APS.WebApp.Models
@model List<ProjectViewModel>

@{
    ViewData["Title"] = "Bem-vindo";
}

@if (ViewBag.IsLoggedIn == true)
{
    // --- SE ESTIVER LOGADO, MOSTRA A GRELHA DE CARDS DE PROJETO ---
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Meus Projetos</h2>
            <p class="text-muted">Selecione um projeto para ver os ficheiros.</p>
        </div>
        <div>
            <span class="me-3">Bem-vindo, <strong>@ViewBag.UserName</strong></span>
            <a href="@Url.Action("Logout", "OAuth", new { area = "Authentication" })" class="btn btn-sm btn-outline-secondary">Logout</a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var project in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 project-card">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title" title="@project.Name">@project.Name</h5>
                            <a asp-area="DataManagement" asp-controller="Data" asp-action="Detalhes" asp-route-id="@project.Id" asp-route-hubId="@project.HubId" class="btn btn-primary mt-auto">
                                Ver Ficheiros
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>Nenhum projeto encontrado ou a sessão expirou.</p>
    }
}
else
{
    // --- SE NÃO ESTIVER LOGADO, MOSTRA A PÁGINA DE LOGIN PROFISSIONAL ---
    <div class="login-container">
        <h1 class="display-4">Portal de Integração APS</h1>
        <p class="lead text-muted mt-3">A sua ferramenta central para integração de dados de engenharia.</p>
        <hr class="my-4" style="width: 50%;" />
        <p>Para começar, por favor, autentique-se com a sua conta da Autodesk.</p>
        <a href="@Url.Action("Login", "OAuth", new { area = "Authentication" })" class="btn btn-lg btn-primary mt-3">
            Login com Autodesk
        </a>
    </div>
}