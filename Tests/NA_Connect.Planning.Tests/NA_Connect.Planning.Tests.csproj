<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Saídas isoladas de validações anteriores não são código de teste. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj_test_alt/**;bin_test_alt/**;obj_test_05a/**;bin_test_05a/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Update="Fixtures\**\*.xls*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\OfficialPlanning\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AccIntegration.WebApp.csproj" />
  </ItemGroup>

</Project>
